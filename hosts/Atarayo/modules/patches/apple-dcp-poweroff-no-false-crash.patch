+	/*
+	 * When the DP sink goes away (e.g. a KVM switch behind a USB-C hub) the
+	 * clear swap may not complete in time. That does not mean DCP crashed;
+	 * real crashes are reported via the RTKit crash handler. Marking DCP as
+	 * crashed here silently rejects every later atomic check until reboot,
+	 * so only warn and continue powering off.
+	 */
+	if (ret <= 0)
+		dev_warn(dcp->dev, "%s: clear swap timed out, continuing\n", __func__);
+	else
+		dev_dbg(dcp->dev, "%s: clear swap submitted: %u\n", __func__, swap_id);
 
